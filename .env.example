# LifeLink Environment Variables Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection string, or leave empty for embedded in-memory database)
MONGODB_URI=mongodb://localhost:27017/lifelink

# Authentication Secrets
JWT_SECRET=lifelink_jwt_super_secret_production_ready_key_2026
JWT_EXPIRES_IN=7d

# External AI Service (Optional - Safe deterministic mock engine activates if empty)
GEMINI_API_KEY=

# Maps Service (Optional - Map coordinates and Haversine distance engine activate if empty)
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Notification Services (Optional - In-app notification engine + console mock activate if empty)
FIREBASE_SERVER_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
